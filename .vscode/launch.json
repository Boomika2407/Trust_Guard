{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: run app.py",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Train model (data/creditcard.csv)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/train.py",
      "args": ["--data", "data/creditcard.csv"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
